# Copy to .env (Windows: copy .env.example .env). Never commit .env.
# Read by docker compose, the backend (backend/app/config.py) and Vite (VITE_ keys only).

# --- FalkorDB (Local Docker or FalkorDB Cloud) ---
FALKORDB_IMAGE=falkordb/falkordb:latest
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_BROWSER_PORT=3000
FALKORDB_GRAPH=landslide
FALKORDB_MEM_LIMIT=1g

# --- Data pipeline (Phase 1) ---
# Put a way to reach you here; Overpass operators ask for it in the User-Agent.
OVERPASS_CONTACT=
# Optional, comma separated, tried in order. Defaults: overpass-api.de then overpass.kumi.systems
# OVERPASS_ENDPOINTS=

# --- Frontend basemap ---
# Keyless OpenFreeMap vector style (OpenStreetMap data). Best-effort public service, no availability guarantee.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Agent (Phase 3, optional) ---
# By default the agent runs deterministically against the graph with no external API key.
# Set ANTHROPIC_API_KEY or OPENAI_API_KEY only when using `--planner auto` for LLM tool selection.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Historical closure persistence (optional, offline fallback mode) ---
# Path to JSON file used by InMemoryGraph to persist simulated/observed closure history across restarts.
# Defaults to data/cache/runtime_history.json when running from the cached normalized dataset.
# LANDSLIDE_HISTORY_FILE=

