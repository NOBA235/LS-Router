# Copy to .env (Windows: copy .env.example .env). Never commit .env.
# Read by docker compose, the backend (backend/app/config.py) and Vite (VITE_ keys only).

# --- FalkorDB ---
FALKORDB_IMAGE=falkordb/falkordb:latest
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
FALKORDB_GRAPH=landslide
FALKORDB_MEM_LIMIT=1g

# --- Data pipeline (Phase 1) ---
# Put a way to reach you here; Overpass operators ask for it in the User-Agent.
OVERPASS_CONTACT=
# Optional, comma separated, tried in order. Defaults: overpass-api.de then overpass.kumi.systems
# OVERPASS_ENDPOINTS=

# --- Frontend basemap ---
# Keyless OpenFreeMap vector style (OpenStreetMap data). Best-effort public service, no availability guarantee.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
